# ============================================================
#  CONFIGURACION DE LA PLATAFORMA  ->  copia este archivo como .env
# ============================================================

# --- Servidor ---
PORT=3000
# URL publica del sitio (SIN diagonal final). Se usa para generar
# los links de las NFC y los correos de invitacion.
APP_URL=https://tudominio.com
# Nombre que aparece en la plataforma y en los correos
APP_NAME=Estructura Metalica

# --- Seguridad ---
# Cambia esto por una cadena larga y aleatoria (minimo 32 caracteres)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria-123456789
# Dias que dura la sesion iniciada en el celular del usuario
SESSION_DAYS=30

# --- Primer administrador (opcional) ---
# Si los dejas vacios, la primera vez que abras el sitio te llevara
# a una pantalla de instalacion para crear al administrador.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# --- Correo (SMTP) para invitaciones y recuperacion de contrasena ---
# Si lo dejas vacio, la plataforma seguira funcionando y te mostrara
# el link de invitacion en pantalla para copiarlo y enviarlo a mano.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Estructura Metalica <no-reply@tudominio.com>"

# --- Archivos ---
# Tamano maximo por archivo en MB
MAX_FILE_MB=200
