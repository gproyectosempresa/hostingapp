<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="pagina">
  <div class="envoltura-angosta">
    <div class="fila mb-2 anim">
      <a href="/admin" class="btn btn-fantasma"><%- icon('flechaIzq', 18) %></a>
      <div>
        <h1 style="margin-bottom:2px">Nuevo proyecto</h1>
        <p class="txt-suave mb-0">Empieza con la lista de piezas: de ahi se llenan solos los datos del proyecto.</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="aviso aviso-error"><%- icon('alerta', 19) %><div><%= error %></div></div>
    <% } %>

    <div class="pasos anim anim-1">
      <div class="paso activo" data-paso="1"><div class="paso-bola">1</div><div class="paso-txt">Piezas</div></div>
      <div class="paso" data-paso="2"><div class="paso-bola">2</div><div class="paso-txt">Proyecto</div></div>
      <div class="paso" data-paso="3"><div class="paso-bola">3</div><div class="paso-txt">Planos</div></div>
      <div class="paso" data-paso="4"><div class="paso-bola">4</div><div class="paso-txt">Modelo 3D</div></div>
    </div>

    <form id="formProyecto" method="post" action="/admin/nuevo" enctype="multipart/form-data">

      <!-- ==================== PASO 1: LISTA DE PIEZAS ==================== -->
      <section class="tarjeta anim anim-2 paso-panel" data-panel="1">
        <div class="tarjeta-cab"><%- icon('lista', 20) %><h2 class="crece">Lista de piezas</h2></div>

        <div class="pestanas" style="position:static;margin-bottom:16px" id="fuentePiezas">
          <button type="button" class="pestana activa" data-fuente="archivo">
            <%- icon('archivo', 16) %> Subir archivo
          </button>
          <button type="button" class="pestana" data-fuente="pegar">
            <%- icon('copiar', 16) %> Pegar la informacion
          </button>
        </div>

        <div data-fuente-panel="archivo">
          <div class="zona" id="zonaPiezas">
            <input type="file" name="piezas" id="inputPiezas" accept=".xlsx,.xls,.csv,.txt">
            <div class="zona-icono"><%- icon('lista', 23) %></div>
            <b>Sube el Excel o CSV de piezas</b>
            <small>.xlsx, .xls o .csv &middot; tambien puedes arrastrarlo aqui</small>
          </div>
          <div class="lista-archivos" id="listaPiezasArchivo"></div>
        </div>

        <div data-fuente-panel="pegar" class="oculto">
          <div class="campo">
            <label for="piezas_texto">Copia las filas en Excel y pegalas aqui</label>
            <textarea id="piezas_texto" name="piezas_texto" style="min-height:190px;font-family:'SF Mono','Cascadia Mono',Consolas,monospace;font-size:13px"
                      placeholder="Pieza	Marca	Cantidad	Peso	Dibujo	Nombre Proyecto	Cliente
UPPER HV CLAMP - 1ZXX461026C8242	UPPER HV CLAMP-	1	995.629656	1ZXX461026C8242	CORE CLAMPS	HITACHI ENERGY"></textarea>
            <small class="ayuda">
              <b>Incluye la fila de encabezados.</b> Selecciona en Excel desde los titulos de las columnas
              hasta la ultima pieza, copia con Ctrl+C y pega aqui con Ctrl+V.
            </small>
          </div>
        </div>

        <div class="aviso aviso-info mt-2">
          <%- icon('info', 19) %>
          <div>
            <b>Columnas que se reconocen solas</b>
            <span class="mono">Marca</span>, <span class="mono">Pieza</span>, <span class="mono">Dibujo</span>,
            <span class="mono">Cantidad</span>, <span class="mono">Peso</span>, <span class="mono">Peso total</span>,
            <span class="mono">Perfil</span>, <span class="mono">Material</span>, <span class="mono">Lote</span>,
            y del proyecto: <span class="mono">Nombre Proyecto</span>, <span class="mono">Proyecto</span>,
            <span class="mono">Cliente</span> y <span class="mono">Code_Cliente</span>.
            No importa el orden en que esten.
          </div>
        </div>

        <div class="fila-entre mt-2">
          <span class="txt-suave txt-chico" id="estadoAnalisis"></span>
          <button type="button" class="btn btn-primario" id="btnAnalizar">
            <%- icon('buscar', 16) %> Leer lista y continuar
          </button>
        </div>
      </section>

      <!-- ==================== PASO 2: DATOS DEL PROYECTO ==================== -->
      <section class="tarjeta anim paso-panel oculto" data-panel="2">
        <div class="tarjeta-cab"><%- icon('edificio', 20) %><h2 class="crece">Datos del proyecto</h2></div>

        <div class="aviso aviso-exito oculto" id="resumenPiezas">
          <%- icon('palomita', 19) %>
          <div class="crece" id="resumenPiezasTxt"></div>
        </div>

        <div class="aviso aviso-info oculto" id="avisoPeso">
          <%- icon('peso', 19) %>
          <div class="crece">
            <b>La columna "Peso" se tomo como el peso TOTAL del renglon</b>
            <div class="txt-chico">Si en este archivo el peso viene por pieza, cambialo aqui:</div>
            <div class="fila mt-1" style="gap:6px;flex-wrap:wrap">
              <button type="button" class="filtro activo" data-peso="1">Peso TOTAL del renglon</button>
              <button type="button" class="filtro" data-peso="0">Peso de UNA pieza</button>
            </div>
            <div class="txt-chico mt-1" id="ejemploPeso"></div>
          </div>
        </div>
        <input type="hidden" name="peso_es_total" id="peso_es_total" value="1">

        <div class="campo">
          <label for="name">Nombre del proyecto *</label>
          <input type="text" id="name" name="name" value="<%= form.name || '' %>" required
                 placeholder="Se llena solo con la lista de piezas">
        </div>

        <div class="fila-campos dos">
          <div class="campo">
            <label for="code">Codigo / No. de proyecto</label>
            <input type="text" id="code" name="code" value="<%= form.code || '' %>" placeholder="E1191">
          </div>
          <div class="campo">
            <label for="client">Cliente</label>
            <input type="text" id="client" name="client" value="<%= form.client || '' %>" placeholder="HITACHI ENERGY USA, INC">
          </div>
        </div>

        <div class="fila-campos dos">
          <div class="campo">
            <label for="client_code">Codigo de cliente</label>
            <input type="text" id="client_code" name="client_code" value="<%= form.client_code || '' %>" placeholder="C00102">
          </div>
          <div class="campo">
            <label for="location">Ubicacion de la obra</label>
            <input type="text" id="location" name="location" value="<%= form.location || '' %>" placeholder="Apodaca, Nuevo Leon">
          </div>
        </div>

        <hr class="sep">

        <div class="fila-campos tres">
          <div class="campo">
            <label for="start_date">Inicio</label>
            <input type="date" id="start_date" name="start_date" value="<%= form.start_date || '' %>">
          </div>
          <div class="campo">
            <label for="due_date" style="color:var(--naranja-oscuro)">Fecha de entrega *</label>
            <input type="date" id="due_date" name="due_date" value="<%= form.due_date || '' %>"
                   style="border-color:#ffd0ac">
          </div>
          <div class="campo">
            <label for="status">Estado</label>
            <select id="status" name="status">
              <option value="activo">Activo</option>
              <option value="pausado">Pausado</option>
              <option value="terminado">Terminado</option>
            </select>
          </div>
        </div>

        <div class="campo">
          <label for="description">Notas para el personal de piso</label>
          <textarea id="description" name="description" placeholder="Indicaciones generales, contacto del residente, restricciones de acceso..."><%= form.description || '' %></textarea>
        </div>

        <div class="campo" id="checklist">
          <label>Etapas del checklist</label>
          <div class="fila mb-1" style="gap:6px;flex-wrap:wrap">
            <button type="button" class="filtro preset-etapas activo" data-etapas="Fabricado">Simple (una palomita)</button>
            <button type="button" class="filtro preset-etapas" data-etapas="Habilitado,Armado,Soldado,Pintura">Por etapas</button>
            <button type="button" class="filtro preset-etapas" data-etapas="Fabricado,Inspeccion,Embarcado">Fabricacion y embarque</button>
          </div>
          <input type="text" id="stages" name="stages" value="Fabricado" placeholder="Fabricado">
          <small class="ayuda">Separa las etapas con comas. Cada pieza tendra una casilla por etapa.</small>
        </div>

        <div class="fila" style="gap:14px;align-items:flex-end">
          <div class="campo" style="margin:0">
            <label for="color">Color</label>
            <input type="color" id="color" name="color" value="<%= form.color || '#2f6fed' %>">
          </div>
          <div class="campo crece" style="margin:0">
            <label for="slug">Direccion web</label>
            <input type="text" id="slug" name="slug" value="<%= form.slug || '' %>" placeholder="se-genera-sola-con-el-nombre">
            <small class="ayuda">Enlace de la NFC: <span class="mono">/p/<span id="vistaSlug">nombre-del-proyecto</span></span></small>
          </div>
        </div>

        <div class="fila-entre mt-2">
          <button type="button" class="btn btn-linea anterior-paso"><%- icon('flechaIzq', 16) %> Atras</button>
          <button type="button" class="btn btn-primario siguiente-paso">Siguiente <%- icon('flecha', 16, 'style="transform:rotate(-90deg)"') %></button>
        </div>
      </section>

      <!-- ==================== PASO 3: PLANOS ==================== -->
      <section class="tarjeta anim paso-panel oculto" data-panel="3">
        <div class="tarjeta-cab"><%- icon('carpeta', 20) %><h2 class="crece">Planos y documentos</h2></div>

        <div class="aviso aviso-info">
          <%- icon('info', 19) %>
          <div>
            <b>Asi se vinculan solos con cada pieza</b>
            El nombre del archivo debe traer el <b>numero de dibujo</b>
            (por ejemplo <span class="mono">1ZXX461026C8242.pdf</span>) o la marca de la pieza.
            Asi cada renglon del checklist muestra su plano.
          </div>
        </div>

        <div class="campo">
          <label>Carpeta completa de planos (PDF, DXF, DWG, imagenes)</label>
          <div class="zona" id="zonaCarpeta">
            <input type="file" id="inputCarpeta" webkitdirectory directory multiple>
            <div class="zona-icono"><%- icon('carpeta', 23) %></div>
            <b>Selecciona la carpeta del proyecto</b>
            <small>Se suben todos los archivos y subcarpetas. Maximo <%= maxMb %> MB por archivo.</small>
          </div>
          <div class="fila mt-1" style="gap:8px">
            <button type="button" class="btn btn-linea btn-chico" id="btnArchivosSueltos">
              <%- icon('archivo', 14) %> O elegir archivos sueltos
            </button>
            <input type="file" id="inputSueltos" multiple class="oculto">
            <span class="txt-suave txt-chico" id="resumenCarpeta"></span>
          </div>
          <div class="lista-archivos" id="listaCarpeta"></div>
        </div>

        <hr class="sep">

        <div class="campo">
          <label>Especificaciones de soldadura (WPS, PQR, normas)</label>
          <div class="zona naranja" id="zonaSoldadura">
            <input type="file" id="inputSoldadura" multiple accept=".pdf,.doc,.docx,.jpg,.png">
            <div class="zona-icono"><%- icon('flama', 23) %></div>
            <b>Sube los PDF de soldadura</b>
            <small>Apareceran en su propia pestana dentro del proyecto.</small>
          </div>
          <div class="lista-archivos" id="listaSoldadura"></div>
        </div>

        <div class="fila-entre mt-2">
          <button type="button" class="btn btn-linea anterior-paso"><%- icon('flechaIzq', 16) %> Atras</button>
          <button type="button" class="btn btn-primario siguiente-paso">Siguiente <%- icon('flecha', 16, 'style="transform:rotate(-90deg)"') %></button>
        </div>
      </section>

      <!-- ==================== PASO 4: MODELO 3D ==================== -->
      <section class="tarjeta anim paso-panel oculto" data-panel="4">
        <div class="tarjeta-cab"><%- icon('cubo', 20) %><h2 class="crece">Modelo 3D en Autodesk</h2></div>

        <div class="campo">
          <label for="viewer_url">Link de visualizacion en linea</label>
          <div class="campo-icono">
            <%- icon('externo', 18) %>
            <input type="url" id="viewer_url" name="viewer_url" value="<%= form.viewer_url || '' %>"
                   placeholder="https://autodesk360.com/shares/public/...">
          </div>
          <small class="ayuda">
            Pega el link que genera Autodesk al compartir el modelo (IFC, RVT, NWD...).
            Si permite incrustarse, el modelo se vera <b>dentro</b> de la pagina del proyecto;
            si no, se muestra un boton grande que lo abre en una pestana nueva.
            Puedes dejarlo vacio y agregarlo despues.
          </small>
        </div>

        <hr class="sep">

        <div class="caja-link">
          <div class="fila" style="gap:9px;margin-bottom:4px">
            <%- icon('nfc', 20) %><b>Al guardar se genera el enlace de la NFC</b>
          </div>
          <div class="txt-chico" style="opacity:.85">
            Vas a poder copiarlo, descargar el codigo QR y grabarlo en la etiqueta con cualquier
            app de NFC (NFC Tools, TagWriter) como registro tipo <b>URL</b>.
          </div>
        </div>

        <div class="fila-entre mt-3">
          <button type="button" class="btn btn-linea anterior-paso"><%- icon('flechaIzq', 16) %> Atras</button>
          <button type="submit" class="btn btn-naranja btn-grande" id="btnGuardar">
            <%- icon('palomita', 18) %> Crear proyecto
          </button>
        </div>
      </section>
    </form>

    <!-- barra de subida -->
    <div class="tarjeta oculto mt-2" id="cajaProgreso">
      <div class="fila mb-1" style="gap:10px">
        <span class="girando" style="color:var(--azul-500)"><%- icon('refrescar', 20) %></span>
        <b class="crece txt-tinta" id="textoProgreso">Subiendo archivos...</b>
        <span class="negrita txt-tinta" id="porcentaje">0%</span>
      </div>
      <div class="barra"><i id="barraProgreso"></i></div>
      <small class="ayuda">No cierres esta ventana. Los archivos grandes pueden tardar varios minutos.</small>
    </div>
  </div>
</div>

<%- include('../partials/tabbar') %>
<script src="/static/js/subida.js"></script>
<%- include('../partials/foot') %>
